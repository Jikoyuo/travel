---
import { testimonials } from '../../data/content.js';
---

<section class="testimonials-section" id="testimonials" aria-label="Traveler Reviews - Tour Guide Yogyakarta">
  <div class="testimonials-inner">
    <header class="testimonials-header">
      <span class="section-label">Traveler Reviews</span>
      <h2 class="section-title">What Our Guests Say About Our Tour Guide Yogyakarta Services</h2>
      <p class="section-subtitle">
        Real stories from travelers who explored Yogyakarta with us. Their experiences speak louder than words.
      </p>
    </header>

    <div class="carousel-wrap">
      <div class="carousel-track" id="carousel-track">
        {testimonials.map((testimonial) => (
          <article class="testimonial-card">
            <div class="rating-row">
              {Array.from({ length: testimonial.rating || 5 }).map(() => (
                <svg class="star-icon" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              ))}
            </div>
            <blockquote class="quote">"{testimonial.quote}"</blockquote>
            <footer class="card-footer">
              <img src={testimonial.avatar || 'https://i.pravatar.cc/150'} alt={`${testimonial.name} - Tour Guide Yogyakarta Review`} class="avatar" loading="lazy" decoding="async" width="48" height="48" />
              <div class="author-info">
                <p class="author-name">{testimonial.name}</p>
                <p class="author-role">{testimonial.role}</p>
              </div>
            </footer>
          </article>
        ))}
      </div>

      <div class="testimonials-empty" id="testimonials-empty" style={testimonials.length === 0 ? '' : 'display:none;'}>
        <p>No traveler reviews published yet in Sanity CMS.</p>
      </div>

      <div class="carousel-controls" id="carousel-controls" style={testimonials.length > 0 ? '' : 'display:none;'}>
        <button class="carousel-btn carousel-btn--prev" id="carousel-prev" aria-label="Previous testimonial review">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <div class="carousel-dots" id="carousel-dots"></div>
        <button class="carousel-btn carousel-btn--next" id="carousel-next" aria-label="Next testimonial review">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  const track = document.getElementById('carousel-track') as HTMLElement;
  const prevBtn = document.getElementById('carousel-prev');
  const nextBtn = document.getElementById('carousel-next');
  const dotsWrap = document.getElementById('carousel-dots');
  const emptyState = document.getElementById('testimonials-empty');
  const controlsWrap = document.getElementById('carousel-controls');

  let current = 0;
  let autoplayTimer: number;
  let isHovering = false;

  function initCarousel() {
    const cards = track?.querySelectorAll('.testimonial-card');
    if (!track || !cards || cards.length === 0) {
      if (emptyState) emptyState.style.display = '';
      if (controlsWrap) controlsWrap.style.display = 'none';
      return;
    }

    if (emptyState) emptyState.style.display = 'none';
    if (controlsWrap) controlsWrap.style.display = 'flex';

    const total = cards.length;

    function getCardsPerView() {
      if (window.innerWidth >= 1024) return 3;
      if (window.innerWidth >= 640) return 2;
      return 1;
    }

    function getMaxIndex() {
      return Math.max(0, total - getCardsPerView());
    }

    function buildDots() {
      if (!dotsWrap) return;
      dotsWrap.innerHTML = '';
      const maxIdx = getMaxIndex();
      for (let i = 0; i <= maxIdx; i++) {
        const dot = document.createElement('button');
        dot.className = `carousel-dot${i === current ? ' carousel-dot--active' : ''}`;
        dot.setAttribute('aria-label', `Go to testimonial slide ${i + 1}`);
        const innerDot = document.createElement('span');
        innerDot.className = 'carousel-dot-inner';
        dot.appendChild(innerDot);
        dot.addEventListener('click', () => goTo(i));
        dotsWrap.appendChild(dot);
      }
    }

    function updateDots() {
      if (!dotsWrap) return;
      const dots = dotsWrap.querySelectorAll('.carousel-dot');
      dots.forEach((dot, i) => {
        dot.classList.toggle('carousel-dot--active', i === current);
      });
    }

    function goTo(index: number) {
      const maxIdx = getMaxIndex();
      current = Math.max(0, Math.min(index, maxIdx));
      const card = cards[0] as HTMLElement;
      if (!card) return;
      const cardWidth = card.offsetWidth;
      const gap = parseInt(getComputedStyle(track).gap) || 20;
      track.style.transform = `translateX(-${current * (cardWidth + gap)}px)`;
      updateDots();
    }

    function next() { goTo(current >= getMaxIndex() ? 0 : current + 1); }
    function prev() { goTo(current <= 0 ? getMaxIndex() : current - 1); }

    function startAutoplay() {
      stopAutoplay();
      autoplayTimer = window.setInterval(() => {
        if (!isHovering) next();
      }, 4500);
    }

    function stopAutoplay() {
      clearInterval(autoplayTimer);
    }

    if (prevBtn) prevBtn.onclick = () => { prev(); startAutoplay(); };
    if (nextBtn) nextBtn.onclick = () => { next(); startAutoplay(); };

    if (track) {
      track.onmouseenter = () => { isHovering = true; };
      track.onmouseleave = () => { isHovering = false; };
    }

    buildDots();
    startAutoplay();
  }

  function deduplicateDrafts(items: any[]) {
    const map = new Map();
    items.forEach(item => {
      const cleanId = item._id.replace(/^drafts\./, '');
      const isDraft = item._id.startsWith('drafts.');
      if (!map.has(cleanId) || isDraft) {
        map.set(cleanId, item);
      }
    });
    return Array.from(map.values());
  }

  // Realtime polling for Sanity Testimonials (every 3s)
  async function fetchRealtimeTestimonials() {
    try {
      const res = await fetch('https://swt686hz.api.sanity.io/v2024-01-01/data/query/production?query=*[_type == "testimonial"]{_id,name,role,avatar,quote,rating}');
      const json = await res.json();
      if (json && json.result && Array.isArray(json.result)) {
        renderTestimonials(deduplicateDrafts(json.result));
      }
    } catch (e) {
      console.warn('Realtime testimonials fetch warning:', e);
    }
  }

  function renderTestimonials(list: any[]) {
    if (!track) return;

    if (list.length === 0) {
      track.innerHTML = '';
      if (emptyState) emptyState.style.display = '';
      if (controlsWrap) controlsWrap.style.display = 'none';
      return;
    }

    track.innerHTML = list.map((item, idx) => {
      const stars = Array.from({ length: item.rating || 5 }).map(() => `
        <svg class="star-icon" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
      `).join('');

      return `
        <article class="testimonial-card">
          <div class="rating-row">${stars}</div>
          <blockquote class="quote">"${item.quote || ''}"</blockquote>
          <footer class="card-footer">
            <img src="${item.avatar || `https://i.pravatar.cc/150?img=${idx + 10}`}" alt="${item.name || ''} - Tour Guide Yogyakarta Review" class="avatar" loading="lazy" decoding="async" width="48" height="48" />
            <div class="author-info">
              <p class="author-name">${item.name || ''}</p>
              <p class="author-role">${item.role || 'Traveler'}</p>
            </div>
          </footer>
        </article>
      `;
    }).join('');

    initCarousel();
  }

  fetchRealtimeTestimonials();
  setInterval(fetchRealtimeTestimonials, 3000);
  initCarousel();

  // Reveal
  const section = document.getElementById('testimonials');
  if (section) {
    const obs = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          obs.unobserve(e.target);
        }
      });
    }, { threshold: 0.1 });
    obs.observe(section);
  }
</script>

<style is:global>
.testimonials-section {
  --green: #2D5016;
  --brown: #8B7355;
  --sand: #D4A574;
  --bg: #FAFAFA;
  --card: #FFFFFF;
  --border: #E8E5E0;
  --ease: cubic-bezier(0.25, 0.46, 0.45, 0.94);
  --radius-lg: 16px;

  padding: var(--space-12, 96px) 0 var(--space-16, 128px);
  background: var(--bg);
  overflow: hidden;
  font-family: 'Plus Jakarta Sans', sans-serif;
  opacity: 0;
  transform: translateY(28px);
  transition: opacity 0.7s var(--ease), transform 0.7s var(--ease);
}

.testimonials-section.is-visible {
  opacity: 1;
  transform: translateY(0);
}

.testimonials-inner {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 clamp(16px, 4vw, 48px);
}

.testimonials-header {
  margin-bottom: 48px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.carousel-wrap { position: relative; }

.carousel-track {
  display: flex;
  gap: 20px;
  transition: transform 0.5s var(--ease);
  will-change: transform;
}

.testimonials-empty {
  text-align: center;
  padding: 48px 0;
  color: #777;
  font-size: 0.95rem;
}

.testimonial-card {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  background: var(--card);
  border: 1px solid rgba(45, 80, 22, 0.12);
  border-radius: var(--radius-lg);
  padding: 2rem;
  min-width: calc(33.333% - 14px);
  max-width: calc(33.333% - 14px);
  flex-shrink: 0;
  box-shadow: 0 2px 16px rgba(45, 80, 22, 0.06);
  transition: box-shadow 0.3s var(--ease), transform 0.3s var(--ease);
}

.testimonial-card:hover {
  box-shadow: 0 8px 32px rgba(45, 80, 22, 0.12);
  transform: translateY(-3px);
}

@media (max-width: 1023px) {
  .testimonial-card { min-width: calc(50% - 10px); max-width: calc(50% - 10px); }
}

@media (max-width: 639px) {
  .testimonial-card { min-width: 100%; max-width: 100%; }
}

.rating-row { display: flex; gap: 0.2rem; }

.star-icon { width: 16px; height: 16px; color: var(--sand); }

.quote {
  margin: 0;
  font-size: 0.9375rem;
  line-height: 1.7;
  color: #3a3a3a;
  font-style: normal;
  flex: 1;
}

.card-footer {
  display: flex;
  align-items: center;
  gap: 0.875rem;
  padding-top: 0.5rem;
  border-top: 1px solid rgba(45, 80, 22, 0.08);
}

.avatar {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  object-fit: cover;
  border: 2px solid var(--green);
  flex-shrink: 0;
}

.author-info { display: flex; flex-direction: column; gap: 0.2rem; }

.author-name {
  margin: 0;
  font-family: 'DM Serif Display', serif;
  font-size: 0.9375rem;
  color: var(--green);
  font-weight: normal;
}

.author-role {
  margin: 0;
  font-size: 0.75rem;
  color: var(--brown);
}

/* Carousel Controls */
.carousel-controls {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  margin-top: 32px;
}

.carousel-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  border: 1.5px solid var(--border);
  background: var(--card);
  color: var(--green);
  cursor: pointer;
  transition: border-color 0.2s, background 0.2s, color 0.2s, transform 0.2s;
}

.carousel-btn:hover {
  border-color: var(--green);
  background: var(--green);
  color: #fff;
  transform: scale(1.08);
}

.carousel-dots { display: flex; gap: 4px; }

.carousel-dot {
  width: 44px;
  height: 44px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: none;
  cursor: pointer;
  padding: 0;
}

.carousel-dot-inner {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--border);
  transition: background 0.3s, transform 0.3s;
}

.carousel-dot--active .carousel-dot-inner {
  background: var(--green);
  transform: scale(1.3);
}

.carousel-dot:hover .carousel-dot-inner { background: var(--brown); }
</style>
