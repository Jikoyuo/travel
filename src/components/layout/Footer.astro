---
import { companyInfo } from '../../data/content.js';

const navLinks = [
  { label: 'Home', href: '/#hero' },
  { label: 'About Us', href: '/#about' },
  { label: 'Tour Packages', href: '/#tours' },
  { label: 'Destinations', href: '/#destinations' },
  { label: 'Why Us', href: '/#features' },
  { label: 'Reviews', href: '/#testimonials' },
  { label: 'FAQ', href: '/#faq' },
  { label: 'Contact', href: '/#contact' },
];

const tourCategories = [
  { label: 'Borobudur Sunrise Tours', href: '/#tours' },
  { label: 'Prambanan & Ramayana', href: '/#tours' },
  { label: 'Jomblang Cave & Nature', href: '/#tours' },
  { label: 'Merapi Jeep Adventure', href: '/#tours' },
  { label: 'Batik & Heritage Trail', href: '/#tours' },
  { label: 'Street Food & Culinary', href: '/#tours' },
];

const policyLinks = [
  { label: 'Privacy Policy', href: '/booking-policy' },
  { label: 'Terms of Service', href: '/booking-policy' },
  { label: 'Cancellation Policy', href: '/cancellation-policy' },
  { label: 'Safety Guidelines', href: '/safety-guidelines' },
  { label: 'Travel Tips', href: '/travel-tips' },
];

const socials = [
  { name: 'Instagram', href: companyInfo.socials.instagram, icon: 'instagram' },
  { name: 'Facebook', href: companyInfo.socials.facebook, icon: 'facebook' },
  { name: 'TikTok', href: companyInfo.socials.tiktok, icon: 'tiktok' },
];

const phoneDigits = companyInfo.phone.replace(/[^0-9+]/g, '');
const whatsappDigits = companyInfo.whatsapp.replace(/[^0-9]/g, '');
---

<footer class="app-footer" aria-label="Site footer">
  <div class="app-footer__inner">
    <!-- Top Grid Section -->
    <div class="footer-grid">
      <!-- Col 1: Brand & Contact Info -->
      <div class="footer-col footer-col--brand">
        <a href="/#hero" class="footer-logo" aria-label="Jogja Discovery Home">
          <svg class="footer-logo-icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M16 3L3 28H29L16 3Z" fill="currentColor" opacity="0.9"/>
            <path d="M16 10L8 24H24L16 10Z" fill="currentColor" opacity="0.6"/>
            <path d="M16 16L12 22H20L16 16Z" fill="currentColor"/>
          </svg>
          <span class="footer-logo-text">{companyInfo.name}</span>
        </a>

        <p class="footer-tagline">
          Discover the soul of Yogyakarta with government-licensed tour guides. Ancient temples, secret caves, volcanic adventures, &amp; rich Javanese heritage.
        </p>

        <!-- Direct Contact List -->
        <div class="footer-contact-list">
          <div class="footer-contact-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>{companyInfo.address}</span>
          </div>
          <a href={`tel:${phoneDigits}`} class="footer-contact-item" aria-label={`Call ${companyInfo.name} Tour Guide`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.59 1.31h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 21 16.92z"/></svg>
            <span>{companyInfo.phone}</span>
          </a>
          <a href={`mailto:${companyInfo.email}`} class="footer-contact-item" aria-label={`Email ${companyInfo.name} Tour Guide`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <span>{companyInfo.email}</span>
          </a>
        </div>

        <!-- Social links -->
        <div class="footer-socials">
          {socials.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="footer-social-link"
              aria-label={`${companyInfo.name} on ${social.name}`}
            >
              {social.icon === 'instagram' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
                </svg>
              )}
              {social.icon === 'facebook' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
                </svg>
              )}
              {social.icon === 'tiktok' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/>
                </svg>
              )}
            </a>
          ))}
        </div>
      </div>

      <!-- Col 2: Navigation Links -->
      <div class="footer-col">
        <h3 class="footer-heading">Navigation</h3>
        <ul class="footer-links">
          {navLinks.map((link) => (
            <li><a href={link.href} class="footer-link">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Popular Tours -->
      <div class="footer-col">
        <h3 class="footer-heading">Popular Tours</h3>
        <ul class="footer-links">
          {tourCategories.map((cat) => (
            <li><a href={cat.href} class="footer-link">{cat.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Trust Badges & WhatsApp Direct -->
      <div class="footer-col footer-col--action">
        <h3 class="footer-heading">Book &amp; Support</h3>
        <p class="footer-action-text">
          Have questions or need a customized Yogyakarta itinerary? Contact our tour guide team via WhatsApp anytime.
        </p>
        <a
          href={`https://wa.me/${whatsappDigits}?text=Hello%20Jogja%20Discovery,%20I%20would%20like%20to%20inquire%20about%20your%20Yogyakarta%20tour%20packages.`}
          target="_blank"
          rel="noopener noreferrer"
          class="footer-wa-btn"
          aria-label="Chat with Tour Guide on WhatsApp"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          Chat on WhatsApp
        </a>
        <div class="footer-trust-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span>Licensed &amp; Certified Guides</span>
        </div>
      </div>
    </div>

    <!-- Divider -->
    <div class="footer-divider"></div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <p class="footer-copyright">
        &copy; {new Date().getFullYear()} {companyInfo.name}. All rights reserved. Tour Guide Service Yogyakarta, Indonesia.
      </p>
      <ul class="footer-policy-list">
        {policyLinks.map((policy) => (
          <li><a href={policy.href} class="footer-policy-link">{policy.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
</footer>

<style>
.app-footer {
  --green: #2D5016;
  --brown: #8B7355;
  --sand: #D4A574;
  --bg: #14230A;
  --card: #1C2F10;
  --text: #EAE6DF;
  --muted: #A3B596;
  --border: rgba(255,255,255,0.1);
  --ease: cubic-bezier(0.25, 0.46, 0.45, 0.94);
  font-family: 'Plus Jakarta Sans', sans-serif;
  background: var(--bg);
  color: var(--text);
  padding: 80px 24px 36px;
  border-top: 1px solid var(--border);
}

.app-footer__inner {
  max-width: 1400px;
  margin: 0 auto;
}

.footer-grid {
  display: grid;
  grid-template-columns: 2.2fr 1fr 1.2fr 1.6fr;
  gap: 48px;
  margin-bottom: 60px;
}

.footer-col--brand {
  display: flex;
  flex-direction: column;
}

.footer-logo {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
  color: #fff;
  margin-bottom: 16px;
}

.footer-logo-icon { width: 28px; height: 28px; color: var(--sand); }
.footer-logo-text { font-family: 'DM Serif Display', serif; font-size: 1.5rem; color: #fff; }

.footer-tagline {
  font-size: 0.9375rem;
  color: var(--muted);
  line-height: 1.65;
  margin: 0 0 24px;
  max-width: 380px;
}

.footer-contact-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-bottom: 24px;
}

.footer-contact-item {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 0.875rem;
  color: var(--muted);
  text-decoration: none;
  transition: color 0.2s;
}

a.footer-contact-item:hover { color: var(--sand); }

.footer-socials {
  display: flex;
  gap: 10px;
}

.footer-social-link {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: rgba(255,255,255,0.06);
  border: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--muted);
  text-decoration: none;
  transition: background 0.2s, color 0.2s, transform 0.2s;
}

.footer-social-link svg { width: 18px; height: 18px; }

.footer-social-link:hover {
  background: var(--green);
  color: #fff;
  transform: translateY(-2px);
}

.footer-heading {
  font-family: 'DM Serif Display', serif;
  font-size: 1.125rem;
  color: #fff;
  margin: 0 0 20px;
  letter-spacing: 0.01em;
}

.footer-links {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.footer-link {
  font-size: 0.875rem;
  color: var(--muted);
  text-decoration: none;
  transition: color 0.2s, transform 0.2s;
  display: inline-block;
}

.footer-link:hover {
  color: #fff;
  transform: translateX(4px);
}

.footer-action-text {
  font-size: 0.875rem;
  color: var(--muted);
  line-height: 1.6;
  margin: 0 0 20px;
}

.footer-wa-btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 12px 22px;
  background: #25D366;
  color: #fff;
  border-radius: 999px;
  font-size: 0.875rem;
  font-weight: 600;
  text-decoration: none;
  box-shadow: 0 4px 16px rgba(37,211,102,0.3);
  transition: transform 0.2s, box-shadow 0.2s;
  margin-bottom: 16px;
}

.footer-wa-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(37,211,102,0.45);
}

.footer-trust-badge {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.75rem;
  color: var(--sand);
  font-weight: 500;
}

.footer-divider {
  height: 1px;
  background: var(--border);
  margin-bottom: 32px;
}

.footer-bottom {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
}

.footer-copyright {
  font-size: 0.8125rem;
  color: var(--muted);
  margin: 0;
}

.footer-policy-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
}

.footer-policy-link {
  font-size: 0.8125rem;
  color: var(--muted);
  text-decoration: none;
  transition: color 0.2s;
}

.footer-policy-link:hover { color: var(--sand); }

@media (max-width: 1100px) {
  .footer-grid {
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }
}

@media (max-width: 640px) {
  .app-footer { padding: 60px 16px 28px; }
  .footer-grid {
    grid-template-columns: 1fr;
    gap: 36px;
  }
  .footer-bottom {
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }
}
</style>
